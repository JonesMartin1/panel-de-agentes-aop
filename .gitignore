# --- Secretos: NUNCA versionar ---
.env
spotify_token.json

# --- Datos de ejecucion: son mensajes reales de terceros (audios, frames, transcripciones) ---
resultados/

# --- Logs en vivo (voz.log es la fuente del chat del panel) ---
logs/

# --- Estado en vivo, cambia todo el tiempo ---
claude_sesion.json
codex_sesion.json
cerebro.json
pausa_escucha.flag
STOP
escribir_en.json
pizarra_estado.json
# Lo que el vigia se acuerda de la vuelta anterior (para no repetir el mismo aviso).
# El vigilar.json SI se versiona; su estado no, que es de esta maquina.
vigilar.json.estado.json
laura_pregunta.json
laura_respuesta.json

# --- Configuracion de TU maquina: tu tunel y tu vigia. Se arman copiando los .ejemplo ---
wpp-config.yml
vigilar.json

# --- Permisos locales de Claude Code (son de cada uno) ---
.claude/settings.local.json*

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Salida generada por graphify (se reconstruye con /graphify) ---
graphify-out/

# --- Worktrees de Claude Code (sesiones paralelas) ---
.claude/worktrees/
seguir_lectura.json

# --- Estado del panel y del celular (cambia todo el tiempo, no es codigo) ---
pestanas_movil.json
nombres_sesiones.json
