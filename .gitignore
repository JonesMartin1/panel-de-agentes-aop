aspecto.json
avisos.json
ajustes_sesiones.json
borradores_sesiones.json
marcas_chat.json
orden_carpetas.json
# La identidad de cada carpeta (icono, color, apodo) y, desde el 2026-08-28, CON QUE
# perfil de Chrome trabaja ese proyecto. Es estado del panel como sus hermanos de
# arriba, y ademas lleva rutas de perfiles de navegador: no va al repo.
aspecto_carpetas.json
pensando.flag
compactar.flag
leer_panel.flag
cortar_voz.flag
escuchar_ya.flag
nueva_sesion.flag
mic_bloqueado.flag
logs/horas_chat.json

# --- Ventana de escritorio (app/escritorio.py) ---
# Donde la dejaste en la pantalla, lo que WebView2 guarda del navegador, y el .ico
# que se genera solo a partir de icono_laura.png.
ventana_escritorio.json
webview_datos/
app/estaticos/icono_laura.ico

# --- Capturas de las pruebas: se regeneran corriendo la prueba ---
pruebas/*.png
pruebas/*.jpg
# Las tandas de `foto_pantallas.py` (antes/despues/claro), que sirven para comparar una
# pantalla consigo misma pixel a pixel. Son megas de PNG y se rehacen en 20 segundos.
pruebas/fotos/
pruebas/voz_falsa.wav
