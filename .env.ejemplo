# Copia este archivo como  .env  (en PowerShell:  copy .env.ejemplo .env)
# y completa solo lo que vayas a usar. Lo que dejes vacio apaga esa funcion,
# no rompe nada.
# NO compartas el .env ni lo subas a git: tiene tus claves.

# =====================================================================
# 1) IMPRESCINDIBLE
# =====================================================================

# Carpeta donde viven los modelos de Whisper y la voz de Piper (unos 6 GB).
# Cualquier carpeta con lugar; se crea sola al bajar los modelos.
# Si la dejas vacia se usa D:\IA\modelos.
WPP_MODELOS=C:\IA\modelos

# Gemini: analiza las transcripciones. Es gratis.
# Sacala en: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_aca_tu_api_key

# =====================================================================
# 2) TELEGRAM (opcional, pero es la forma mas facil de mandarle audios)
# =====================================================================

# Te lo da @BotFather en Telegram: le escribis /newbot y te pasa el token.
TELEGRAM_TOKEN=
# Tu id de usuario de Telegram (un numero). Escribile /start a tu bot y te lo dice.
# A ese id le llegan los resultados de WhatsApp y los avisos.
TELEGRAM_DEST_ID=
# ⚠ QUIEN puede hablarle a Laura por Telegram. Poné SOLO tu id.
# Laura ejecuta comandos en tu computadora: cualquiera en esta lista puede usarla.
TELEGRAM_ALLOWED_IDS=
# Quien puede mandarle audios para TRANSCRIBIR (ids separados por coma).
# Vacio = cualquiera que encuentre el bot. Es independiente del candado de arriba.
TELEGRAM_EQUIPO_IDS=

# =====================================================================
# 3) WHATSAPP (opcional; es la parte que mas infraestructura pide)
# =====================================================================

# Camino A — WaSenderAPI (servicio pago, sin servidor propio).
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=

# Camino B — Evolution API (gratis, pero en tu propio servidor con Docker).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Tu numero de WhatsApp (ej. +5493790000000). Solo ese puede hablarle a Laura por
# WhatsApp; vacio = apagado. Se pueden poner varios identificadores separados por coma.
MI_WHATSAPP=
# Grupos de WhatsApp cuyos audios SI se transcriben (ids "...@g.us", separados por
# coma). Vacio = se ignoran todos los grupos.
WPP_GRUPOS_OK=
# 1 = recibe audios pero no contesta por WhatsApp (el resultado va por Telegram).
WPP_SOLO_ESCUCHA=
# Clave que tiene que mandar n8n (u otro sistema) para usar el webhook y la pagina
# /subir. Inventá una larga y guardala.
LAPTOP_SHARED_SECRET=

# =====================================================================
# 4) OPCIONALES
# =====================================================================

# Spotify ("Venus, pone tal cancion"). Necesita cuenta PREMIUM.
# 1) https://developer.spotify.com/dashboard -> Create app
# 2) En "Redirect URIs" poner EXACTAMENTE (con 127.0.0.1, NO localhost):
#        http://127.0.0.1:8888/callback
# 3) Pegar aca el Client ID y el Client Secret
# 4) Autorizar una sola vez:  python -m app.voz.spotify --autorizar
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Hablarle a Laura desde el celular por una pagina web. Vacio = apagado.
# Inventá una clave larga; es la que vas a poner en el celular.
LAURA_VOZ_TOKEN=

# Laura por un canal de voz de Discord.
DISCORD_BOT_TOKEN=
DISCORD_USUARIO_ID=

# Palabra clave con Picovoice (camino alternativo, casi nadie lo necesita).
PICOVOICE_ACCESS_KEY=

# "completo" (Laura puede escribir archivos y ejecutar comandos) o "lectura"
# (solo lee y busca). Si no estas seguro, empezá con lectura.
CLAUDE_VOZ_MODO=lectura
